{
  "name": "@counthouse/site",
  "private": true,
  "description": "Static website of the first business that uses Counthouse. Built for that business; not part of the product.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check:i18n": "node scripts/check-i18n.mts",
    "check:search": "node scripts/check-search.mts",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:a11y": "playwright test",
    "test:lighthouse": "node scripts/lighthouse.mts",
    "test:unit": "TZ=Asia/Tokyo node --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "lighthouse": "13.6.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@nicolassancho/ui": "5.4.0",
    "lucide-react": "1.75.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1",
    "tailwind-variants": "3.3.1"
  }
}
